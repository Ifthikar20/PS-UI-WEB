# Origin of the Django API (server-side only — never exposed to the browser).
DJANGO_API_URL=http://localhost:8000

# Origin the hosted HTML game bundles are served from.
# Dev: the Django backend serves games_host. Prod: your CDN (e.g. https://playstudy.app).
NEXT_PUBLIC_GAMES_BASE_URL=http://localhost:8000

# App version reported to the backend (game manifest gating / telemetry).
NEXT_PUBLIC_APP_VERSION=1.0.0

# --- Social sign-in (both buttons work the moment these are set) -----------
# Google: create an OAuth "Web application" client at
# https://console.cloud.google.com/apis/credentials, add your origins
# (http://localhost:3000 + production) as authorized JavaScript origins,
# then paste the client ID in BOTH places:
#   web  → NEXT_PUBLIC_GOOGLE_CLIENT_ID (here)
#   API  → GOOGLE_OAUTH_CLIENT_IDS in the Django env (comma-separated list)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Apple: a Services ID from https://developer.apple.com/account/resources
# (web → NEXT_PUBLIC_APPLE_CLIENT_ID here, API → APPLE_BUNDLE_IDS in Django).
NEXT_PUBLIC_APPLE_CLIENT_ID=
